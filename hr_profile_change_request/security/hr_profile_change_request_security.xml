<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Employee: can only read/write/create their own requests -->
    <record id="hr_profile_change_request_rule_user" model="ir.rule">
        <field name="name">HR Profile Change Request: own requests only</field>
        <field name="model_id" ref="model_hr_profile_change_request"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- HR Manager: can read/write all requests -->
    <record id="hr_profile_change_request_rule_manager" model="ir.rule">
        <field name="name">HR Profile Change Request: HR manager full access</field>
        <field name="model_id" ref="model_hr_profile_change_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <!-- Employee: can only read/write/create their own request lines -->
    <record id="hr_profile_change_request_line_rule_user" model="ir.rule">
        <field name="name">HR Profile Change Request Line: own lines only</field>
        <field name="model_id" ref="model_hr_profile_change_request_line"/>
        <field name="domain_force">[('request_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- HR Manager: can read/write all request lines -->
    <record id="hr_profile_change_request_line_rule_manager" model="ir.rule">
        <field name="name">HR Profile Change Request Line: HR manager full access</field>
        <field name="model_id" ref="model_hr_profile_change_request_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

</odoo>
