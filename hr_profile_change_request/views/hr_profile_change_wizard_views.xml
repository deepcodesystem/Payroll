<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form -->
    <record id="hr_profile_change_wizard_form" model="ir.ui.view">
        <field name="name">hr.profile.change.wizard.form</field>
        <field name="model">hr.profile.change.wizard</field>
        <field name="arch" type="xml">
            <form string="Demander une modification">
                <group>
                    <field name="employee_id" readonly="1"/>
                </group>
                <p class="text-muted mb-3">
                    Modifiez uniquement les champs que vous souhaitez changer.
                    Les champs non modifiés seront ignorés.
                </p>
                <field name="line_ids" readonly="0">
                    <list editable="bottom" create="0" delete="0">
                        <field name="field_label" string="Champ"/>
                        <field name="current_value" string="Valeur actuelle" readonly="1"/>
                        <field name="new_value" string="Nouvelle valeur"/>
                        <field name="field_name" invisible="1" force_save="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_submit" string="Soumettre la demande"
                            type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="hr_profile_change_wizard_action" model="ir.actions.act_window">
        <field name="name">Demander une modification</field>
        <field name="res_model">hr.profile.change.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
