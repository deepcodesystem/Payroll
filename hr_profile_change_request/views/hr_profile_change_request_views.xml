<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="hr_profile_change_request_form" model="ir.ui.view">
        <field name="name">hr.profile.change.request.form</field>
        <field name="model">hr.profile.change.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Soumettre"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approuver"
                            type="object" class="btn-success"
                            invisible="state != 'pending' or not can_approve"/>
                    <button name="action_refuse" string="Refuser"
                            type="object" class="btn-danger"
                            invisible="state != 'pending' or not can_approve"/>
                    <button name="action_reset_to_draft" string="Remettre en brouillon"
                            type="object"
                            invisible="state != 'refused'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="user_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                            <field name="response_date"/>
                            <field name="can_approve" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Modifications demandées" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="field_name" readonly="state != 'draft'"/>
                                    <field name="field_label" readonly="1"/>
                                    <field name="old_value" readonly="1"/>
                                    <field name="new_value" readonly="state != 'draft'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Commentaire RH" name="hr_comment">
                            <field name="hr_comment" placeholder="Commentaire du responsable RH..."
                                   readonly="state != 'pending' or not can_approve"/>
                        </page>
                    </notebook>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View (HR) -->
    <record id="hr_profile_change_request_list" model="ir.ui.view">
        <field name="name">hr.profile.change.request.list</field>
        <field name="model">hr.profile.change.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="request_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'refused'"/>
                <field name="hr_comment" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Kanban View (HR) -->
    <record id="hr_profile_change_request_kanban" model="ir.ui.view">
        <field name="name">hr.profile.change.request.kanban</field>
        <field name="model">hr.profile.change.request</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="state"/>
                <field name="request_date"/>
                <field name="hr_comment"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top mb8">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>
                            <strong>
                                <field name="employee_id"/>
                            </strong>
                        </div>
                        <div class="o_kanban_record_body">
                            <field name="request_date"/>
                            <field name="hr_comment" invisible="not hr_comment"/>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left">
                                <field name="state" widget="badge"
                                       decoration-success="state == 'approved'"
                                       decoration-warning="state == 'pending'"
                                       decoration-danger="state == 'refused'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="hr_profile_change_request_search" model="ir.ui.view">
        <field name="name">hr.profile.change.request.search</field>
        <field name="model">hr.profile.change.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <filter name="draft" string="Brouillons" domain="[('state', '=', 'draft')]"/>
                <filter name="pending" string="En attente" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="Approuvées" domain="[('state', '=', 'approved')]"/>
                <filter name="refused" string="Refusées" domain="[('state', '=', 'refused')]"/>
                <separator/>
                <filter name="my_requests" string="Mes demandes"
                        domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Group">
                    <filter string="Employé" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="État" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'request_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="hr_profile_change_request_action" model="ir.actions.act_window">
        <field name="name">Demandes de modification</field>
        <field name="res_model">hr.profile.change.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="hr_profile_change_request_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune demande de modification
            </p>
            <p>
                Les employés peuvent soumettre des demandes de modification
                de leur profil RH depuis leur espace.
            </p>
        </field>
    </record>

    <!-- Action pour l'employé (ses propres demandes) -->
    <record id="hr_profile_change_request_action_my" model="ir.actions.act_window">
        <field name="name">Mes demandes de modification</field>
        <field name="res_model">hr.profile.change.request</field>
        <field name="view_mode">form,list</field>
        <field name="search_view_id" ref="hr_profile_change_request_search"/>
        <field name="context">{'search_default_my_requests': 1, 'default_employee_id': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune demande de modification
            </p>
            <p>
                Vous pouvez soumettre une demande de modification
                de votre profil RH en cliquant sur le bouton ci-dessous.
            </p>
        </field>
    </record>

</odoo>
