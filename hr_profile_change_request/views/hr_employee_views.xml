<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Profile form: button to open the change wizard -->
    <record id="hr_profile_view_form_request" model="ir.ui.view">
        <field name="name">hr.profile.view.form.request</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="hr.res_users_view_form_profile"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(hr_profile_change_request.hr_profile_change_wizard_action)d"
                        type="action" class="oe_stat_button btn-primary" icon="fa-pencil-square-o">
                    <span>Demander une modification</span>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
