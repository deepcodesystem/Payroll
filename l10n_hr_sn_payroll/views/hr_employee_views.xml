<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_employee_inherited_sn_payroll" model="ir.ui.view">
            <field name="name">Senegalese Payroll Employee</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='marital']" position="after">
                    <field name="conjoint_salarie" invisible="marital != 'married'"/>
                    <field name="quotient_familial"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
