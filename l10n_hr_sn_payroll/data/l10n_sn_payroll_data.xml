    <record id="hr_payslip_rule_brut_imposable" model="hr.salary.rule">
        <field name="name">Revenu Brut Imposable Annuel</field>
        <field name="code">BRUT_IMP</field>
        <field name="sequence">1300</field>
        <field name="category_id" ref="NOCAT"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute"># Revenu annuel brut imposable après abattement de 30%
# = (SBI - Cotisations Sociales IPRES) avec cumul des mois précédents
# Considérer le (SBI - IPRES) cumulé des mois précédents de l'année

# 1. Récupérer le SBI et IPRES du mois actuel
sbi_actuel = SBI

mois_actuel = payslip.date_from.month
annee_actuelle = payslip.date_from.year

# 2. Calculer le (SBI - IPRES) cumulé des mois précédents
sbi_slip = 0
for slip in employee.slip_ids:
    if slip.date_from.year == annee_actuelle and slip.state == "done":
        slip_month = slip.date_from.month
        if slip_month &lt; mois_actuel:  # Mois précédents seulement
            sbi_slip = 0
            ipres_slip = 0
            for line in slip.line_ids:
                if line.code == "SBI":
                    sbi_slip += line.total

# 4. Calculer le revenu annuel brut imposable avec abattement de 30%
brut_annuel = sbi_actuel * 12 if mois_actuel == 1 else sbi_slip + (sbi_actuel * (13 - mois_actuel))
abattement = min(brut_annuel*0.30, 900000)
result = round((brut_annuel - abattement), -3) </field>
        <field name="appears_on_payslip" eval="False"/>
    </record>

    <record id="hr_payslip_rule_trimf" model="hr.salary.rule">
        <field name="name">TRIMF (Taxe Représentative de l'Impôt Minimum Forfaitaire)</field>
        <field name="code">TRIMF</field>
        <field name="sequence">1350</field>
        <field name="category_id" ref="NOCAT"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# TRIMF - Barème annuel basé sur le Salaire Brut Imposable annuel
revenu_annuel = SBI * 12

if revenu_annuel &lt;= 599999:
    trimf_annuel = 900
elif revenu_annuel &lt;= 999999:
    trimf_annuel = 3600
elif revenu_annuel &lt;= 1999999:
    trimf_annuel = 4800
elif revenu_annuel &lt;= 6999999:
    trimf_annuel = 12000
elif revenu_annuel &lt;= 11999999:
    trimf_annuel = 18000
else:
    trimf_annuel = 36000

result = trimf_annuel / 12
        </field>
        <field name="appears_on_payslip" eval="True"/>
    </record>

    <record id="hr_payslip_rule_ir_avant_reduction" model="hr.salary.rule">
        <field name="name">IR avant réduction (Barème)</field>
        <field name="code">IR_BRUT</field>
        <field name="sequence">1400</field>
        <field name="category_id" ref="NOCAT"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Barème progressif annuel
revenu_imposable = BRUT_IMP

if revenu_imposable &lt;= 630000:
    ir = 0
elif revenu_imposable &lt;= 1500000:
    ir = (revenu_imposable - 630000) * 0.20
elif revenu_imposable &lt;= 4000000:
    ir = (630000 * 0 + (1500000 - 630000) * 0.20) + (revenu_imposable - 1500000) * 0.30
    ir = 174000 + (revenu_imposable - 1500000) * 0.30
elif revenu_imposable &lt;= 8000000:
    ir = 174000 + (4000000 - 1500000) * 0.30 + (revenu_imposable - 4000000) * 0.35
    ir = 174000 + 750000 + (revenu_imposable - 4000000) * 0.35
    ir = 924000 + (revenu_imposable - 4000000) * 0.35
elif revenu_imposable &lt;= 13500000:
    ir = 924000 + (8000000 - 4000000) * 0.35 + (revenu_imposable - 8000000) * 0.37
    ir = 924000 + 1400000 + (revenu_imposable - 8000000) * 0.37
    ir = 2324000 + (revenu_imposable - 8000000) * 0.37
elif revenu_imposable &lt;= 50000000:
    ir = 2324000 + (13500000 - 8000000) * 0.37 + (revenu_imposable - 13500000) * 0.40
    ir = 2324000 + 2035000 + (revenu_imposable - 13500000) * 0.40
    ir = 4359000 + (revenu_imposable - 13500000) * 0.40
else:
    ir = 4359000 + (50000000 - 13500000) * 0.40 + (revenu_imposable - 50000000) * 0.43
    ir = 4359000 + 14600000 + (revenu_imposable - 50000000) * 0.43
    ir = 18959000 + (revenu_imposable - 50000000) * 0.43

result = ir 
        </field>
        <field name="appears_on_payslip" eval="False"/>
    </record>

    <record id="hr_payslip_rule_ir_reduction" model="hr.salary.rule">
        <field name="name">Réduction IR pour charge de famille</field>
        <field name="code">IR_RED</field>
        <field name="sequence">1410</field>
        <field name="category_id" ref="NOCAT"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Réduction IR basée sur le nombre de parts (nombre d'enfants)
# Récupérer le nombre de parts de l'employé
nb_parts = int(employee.quotient_familial)

# Déterminer le taux et les montants min/max de réduction
if nb_parts &gt;= 5:
    taux = 0.45
    reduction_min = 800000
    reduction_max = 3180000
elif nb_parts &gt;= 4.5:
    taux = 0.40
    reduction_min = 700000
    reduction_max = 2755000
elif nb_parts &gt;= 4:
    taux = 0.35
    reduction_min = 600000
    reduction_max = 2490000
elif nb_parts &gt;= 3.5:
    taux = 0.30
    reduction_min = 500000
    reduction_max = 2030000
elif nb_parts &gt;= 3:
    taux = 0.25
    reduction_min = 400000
    reduction_max = 1650000
elif nb_parts &gt;= 2.5:
    taux = 0.20
    reduction_min = 300000
    reduction_max = 1100000
elif nb_parts &gt;= 2:
    taux = 0.15
    reduction_min = 200000
    reduction_max = 650000
elif nb_parts &gt;= 1.5:
    taux = 0.10
    reduction_min = 100000
    reduction_max = 300000
else:
    taux = 0
    reduction_min = 0
    reduction_max = 0

# Calculer la réduction (montant annuel puis mensuel)
reduction_annuelle = min(IR_BRUT * taux, reduction_max)
reduction_annuelle = max(reduction_annuelle, reduction_min)
result = reduction_annuelle
        </field>
        <field name="appears_on_payslip" eval="False"/>
    </record>

    <record id="hr_payslip_rule_ir" model="hr.salary.rule">
