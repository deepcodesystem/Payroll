    <record id="hr_payslip_rule_primanc" model="hr.salary.rule">
        <field name="name">Prime d'ancienneté</field>
        <field name="code">PRIMANC</field>
        <field name="sequence">200</field>
        <field name="category_id" ref="PRINT"/>
        <field name="condition_select">python</field>
        <field name="condition_python">
# Calculer le nombre de mois complets d'ancienneté
date_start = contract.date_start
date_calc = payslip.date_from
months_worked = (date_calc.year - date_start.year) * 12 + (date_calc.month - date_start.month)
# Prime d'ancienneté requiert minimum 2 ans (24 mois)
result = months_worked &gt;= 24
        </field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">
# Calculer les années d'ancienneté complètes
date_start = contract.date_start
date_calc = payslip.date_from
months_worked = (date_calc.year - date_start.year) * 12 + (date_calc.month - date_start.month)
years_worked = months_worked // 12

# Base de calcul: salaire minimum de la catégorie (minima_categ_amount)
base = contract.minima_categ_amount

# Déterminer le pourcentage selon l'ancienneté
# Article 45 CCN: 2% après 2 ans + 1% par année supplémentaire jusqu'à 25 ans
percentage = 2 + (years_worked - 2)  # Formule: 2% + (années - 2) * 1%
percentage = min(percentage, 25)  # Plafonner à 25% (25ème année incluse)
percentage = percentage / 100.0  # Convertir en décimal (ex: 2 -> 0.02)

result = (base * percentage) / 26  # Diviser par 26 jours pour le salaire journalier
        </field>
        <field name="appears_on_payslip" eval="True"/>
        <field name="register_id" ref="contrib_register_employees"/>
    </record>

