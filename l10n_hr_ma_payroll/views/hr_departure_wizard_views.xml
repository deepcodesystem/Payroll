<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_departure_wizard_view_form_ma" model="ir.ui.view">
        <field name="name">hr.departure.wizard.form.moroccan</field>
        <field name="model">hr.departure.wizard</field>
        <field name="inherit_id" ref="hr_contract.hr_departure_wizard_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='activities']" position="inside">
                <div>
                    <field name="calculate_stc"/>
                    <label for="calculate_stc" string="Solde Tout Compte"/>
                </div>
                <field name="stc_notes" widget="text" nolabel="1" invisible="not calculate_stc" class="text-muted"/>
            </xpath>
        </field>
    </record>
</odoo>
