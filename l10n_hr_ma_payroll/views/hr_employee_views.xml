<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_employee_inherited_ma_payroll" model="ir.ui.view">
            <field name="name">Moroccan Payroll employee</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <data>
                     <xpath expr="//field[@name='children']" position="after">
                         <field name="dependants"/>
                     </xpath>
                    <xpath expr="//field[@name='ssnid']" position="after">
                         <field name="cimr_id"/>
                        <field name="cimr_date"/>
                     </xpath>
                    <xpath expr="//field[@name='pin']" position="before">
                         <field name="matricule"/>
                     </xpath>
                    <xpath expr="//group[@name='departure']" position="inside">
                         <field name="stc_settlement" widget="boolean" readonly="1"/>
                    </xpath>
                </data>
            </field>
        </record>
    </data>
</odoo>
