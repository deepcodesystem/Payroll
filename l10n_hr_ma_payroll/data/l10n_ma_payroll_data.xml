    <record id="hr_payslip_rule_ir" model="hr.salary.rule">
        <field name="name">Impôt sur le Revenu</field>
        <field name="code">IR</field>
        <field name="sequence">2000</field>
        <field name="category_id" ref="IR"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute"># 1. Calculer le SNI total connu jusqu'à présent (mois actuels + précédents)
sni_mensuel = SNI
sni_connu = SNI
mois_actuel = payslip.date_from.month
annee_actuelle = payslip.date_from.year
sni_par_mois = {mois_actuel: SNI}  # Pour le débogage

for slip in employee.slip_ids:
    if slip.date_from.year == annee_actuelle and slip.state == "done":
        slip_month = slip.date_from.month
        for line in slip.line_ids:
            if line.code == "SNI":
                sni_connu += line.total
        sni_du_mois = sni_connu
        sni_par_mois[slip_month] = sni_du_mois

# 2. Estimation du SNI annuel
if mois_actuel == 12:
    # En décembre, on a le SNI annuel exact
    sni_annuel = sni_connu
else:
    # Pour les autres mois, on estime basé sur les données connues
    nombre_mois_connus = len(sni_par_mois)
    if nombre_mois_connus &gt; 1:
        # Si nous avons des données pour plusieurs mois, faire une moyenne précise
        sni_moyen = sni_connu / nombre_mois_connus
        sni_annuel = sni_connu + (sni_moyen * (12 - nombre_mois_connus))
    else:
        # Si nous n'avons que le mois actuel, projeter pour l'année
        sni_annuel = sni_mensuel * 12

# 3. Calculer l'IR annuel selon le barème progressif
# Application du barème de l'IR annuel
ir_annuel = 0

# Tranche 1: 0 à 40 000 DH -&gt; 0%
if sni_annuel &lt;= 40000:
    ir_annuel = 0
# Tranche 2: 40 001 à 60 000 DH -&gt; 10% avec déduction de 4 000 DH
elif sni_annuel &lt;= 60000:
    ir_annuel = (sni_annuel * 0.10) - 4000
# Tranche 3: 60 001 à 80 000 DH -&gt; 20% avec déduction de 10 000 DH
elif sni_annuel &lt;= 80000:
    ir_annuel = (sni_annuel * 0.20) - 10000
# Tranche 4: 80 001 à 100 000 DH -&gt; 30% avec déduction de 18 000 DH
elif sni_annuel &lt;= 100000:
    ir_annuel = (sni_annuel * 0.30) - 18000
# Tranche 5: 100 001 à 180 000 DH -&gt; 34% avec déduction de 22 000 DH
elif sni_annuel &lt;= 180000:
    ir_annuel = (sni_annuel * 0.34) - 22000
# Tranche 6: Plus de 180 000 DH -&gt; 37% avec déduction de 27 400 DH
else:
    ir_annuel = (sni_annuel * 0.37) - 27400

# 6. Déduction des charges familiales
# Récupérer le nombre de personnes à charge
personnes_a_charge = employee.dependants or 0  # À adapter selon votre configuration

# Plafonner à 6 personnes à charge maximum
personnes_a_charge = min(personnes_a_charge, 6)
deduction_charges_familiales_annuel = min((personnes_a_charge * 600), 3600)  # Plafonnement à 3600 DH par an

# Appliquer la déduction des charges familiales
ir_annuel = max(ir_annuel - deduction_charges_familiales_annuel, 0)

# 7. Calculer l'IR pour ce mois particulier
# IR déjà payé dans les mois précédents
ir_deja_paye = 0
for slip in employee.slip_ids:
    if slip.date_from.year == annee_actuelle and slip.state == "done":
        for line in slip.line_ids:
            if line.code == "IR":
                ir_deja_paye += line.total
                break

# Calcul de l'IR mensuel au prorata du SNI mensuel
if sni_annuel &gt; 0:  # Éviter division par zéro
    ratio_mensuel = sni_mensuel / sni_annuel
    ir_mensuel_theorique = ir_annuel * ratio_mensuel
else:
    ir_mensuel_theorique = 0

# Calcul de l'IR restant à payer pour l'année
ir_restant = ir_annuel - ir_deja_paye

# Éviter de dépasser l'IR annuel si les variations mensuelles sont importantes
ir_mensuel = min(ir_mensuel_theorique, ir_restant)

# 8. Résultat final (ne peut pas être négatif)
result = max(ir_mensuel, 0)

# Information de débogage
#debug_info = """
#SNI mensuel: {:.2f} DH
#SNI connu à ce jour: {:.2f} DH
#SNI annuel estimé: {:.2f} DH
#IR annuel calculé (avant charges fam.): {:.2f} DH
#Personnes à charge: {}
#Déduction charges familiales: {:.2f} DH
#IR annuel final: {:.2f} DH
#IR déjà payé: {:.2f} DH
#Ratio mensuel: {:.2f}%
#IR du mois: {:.2f} DH
#""".format(
#    sni_mensuel,
#    sni_connu,
#    sni_annuel,
#    ir_annuel + deduction_charges_familiales_annuel,
#    personnes_a_charge,
#    deduction_charges_familiales_annuel,
#    ir_annuel,
#   ir_deja_paye,
#    ratio_mensuel * 100 if sni_annuel > 0 else 0,
#    ir_mensuel
#)

#payslip.write({'note': debug_info})
        </field>
        <field name="appears_on_payslip" eval="True"/>
    </record>

    <record id="hr_payslip_rule_frpro" model="hr.salary.rule">
        <field name="name">Frais Professionnels</field>
        <field name="code">FRPRO</field>
        <field name="sequence">1500</field>
        <field name="category_id" ref="NOCAT"/>
        <field name="parent_rule_id" ref="hr_payslip_rule_ir"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute"># Récupérer le SBI du mois courant
sbi_mensuel = SBI or 0.0

# 1. Calculer le SBI total connu jusqu'à présent (mois actuels + précédents)
sbi_connu = sbi_mensuel
mois_actuel = payslip.date_from.month
annee_actuelle = payslip.date_from.year
sbi_par_mois = {mois_actuel: sbi_mensuel}  # Stockage par mois pour débogage

for slip in employee.slip_ids:
    slip_month = slip.date_from.month
    if slip.date_from.year == annee_actuelle and slip.state == "done":
        for line in slip.line_ids:
            if line.code == 'SBI':
                sbi_valeur = line.total
                sbi_connu += sbi_valeur
                sbi_par_mois[slip_month] = sbi_valeur
                break

# 2. Calcul du taux basé sur le SBI annuel connu ou projeté
# Si nous sommes en décembre, nous connaissons le SBI exact, sinon projection
if mois_actuel == 12:
    # En décembre, on a le SBI annuel exact
    sbi_annuel = sbi_connu
else:
    # Pour les autres mois, on estime basé sur les données connues
    nombre_mois_connus = len(sbi_par_mois)
    if nombre_mois_connus &gt; 1:
        # Si nous avons des données pour plusieurs mois, faire une moyenne plus précise
        somme_sbi_connu = sbi_connu
        sbi_moyen = somme_sbi_connu / nombre_mois_connus
        sbi_annuel = somme_sbi_connu + (sbi_moyen * (12 - nombre_mois_connus))
    else:
        # Si nous n'avons que le mois actuel, projeter pour l'année
        sbi_annuel = sbi_mensuel * 12

# 3. Déterminer le taux basé sur le SBI annuel estimé
if sbi_annuel &lt;= 78000:
    taux = 0.35  # 35%
else:
    taux = 0.25  # 25%

# 4. Calcul des frais professionnels pour l'année entière
frais_pro_annuel = min(sbi_annuel * taux, 35000)  # Plafonnement à 35000 DH

# 5. Retrouver les frais professionnels déjà attribués cette année
frais_pro_deja_attribues = 0
for slip in employee.slip_ids:
    if slip.date_from.year == annee_actuelle and slip.state == "done":
        for line in slip.line_ids:
            if line.code == "FRPRO":
                frais_pro_deja_attribues += line.total
                break

# 6. Calculer les frais pro pour ce mois (au prorata du SBI mensuel par rapport au SBI annuel)
if sbi_annuel &gt; 0:  # Éviter division par zéro
    ratio_mensuel = sbi_mensuel / sbi_annuel
    frais_pro_theorique_mensuel = frais_pro_annuel * ratio_mensuel
else:
    frais_pro_theorique_mensuel = 0

# 7. Vérifier si avec ce montant on ne dépasse pas le total annuel
frais_pro_restant = frais_pro_annuel - frais_pro_deja_attribues
frais_pro_mensuel = min(frais_pro_theorique_mensuel, frais_pro_restant)

# Résultat final
result = max(frais_pro_mensuel, 0)

# Information de débogage
#debug_info = """
