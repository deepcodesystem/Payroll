    <!-- HR SALARY RULES-->
    <record id="hr_payslip_rule_jrtv" model="hr.salary.rule">
        <field name="name">NB Jours Travaillés</field>
        <field name="code">JRTV</field>
        <field name="sequence">5</field>
        <field name="category_id" ref="NOCAT"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute"># Base de 26 jours ouvrables
jours_base = 26

# Déduction des absences
absences = -(worked_days.ABS.number_of_days) if worked_days.ABS else 0

# Déduction des congés
conges = -(worked_days.LEAVE120.number_of_days) if worked_days.LEAVE120 else 0

# Calcul des jours non travaillés en début de mois selon date de début de contrat
jours_debut_mois = 0
if contract.date_start:
    debut_periode = payslip.date_from
    fin_periode = payslip.date_to

    # Si le contrat commence dans la période de paie
    if debut_periode &lt;= contract.date_start &lt;= fin_periode:
        # Calculer la différence de jours
        delta_jours = (contract.date_start - debut_periode).days

        # Compter les jours ouvrables (exclure les dimanches)
        for i in range(delta_jours):
            jour_actuel = debut_periode.replace(day=debut_periode.day + i)
            if jour_actuel.weekday() != 6:  # Pas dimanche
                jours_debut_mois += 1

# Calcul des jours non travaillés en fin de mois selon date de fin de contrat
jours_fin_mois = 0
if contract.date_end:
    debut_periode = payslip.date_from
    fin_periode = payslip.date_to

    # Si le contrat se termine dans la période de paie
    if debut_periode &lt;= contract.date_end &lt;= fin_periode:
        # Calculer du jour après la fin jusqu'à la fin de période
        date_debut_calcul = contract.date_end.replace(day=contract.date_end.day + 1)
        delta_jours = (fin_periode - date_debut_calcul).days + 1

        # Compter les jours ouvrables (exclure les dimanches)
        for i in range(delta_jours):
            jour_actuel = date_debut_calcul.replace(day=date_debut_calcul.day + i)
            if jour_actuel.weekday() != 6:  # Pas dimanche
                jours_fin_mois += 1

# Calcul final
result = max(0, jours_base - absences - abs(conges) - jours_debut_mois - jours_fin_mois)
        </field>
        <field name="appears_on_payslip" eval="True"/>
    </record>

