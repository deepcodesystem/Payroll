<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payslip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- En-tête -->
                        <div style="background-color: #2E86AB; color: white; padding: 20px; margin-bottom: 20px; border-radius: 8px;">
                            <h1 style="margin: 0; font-size: 24px; font-weight: bold;">BULLETIN DE PAIE</h1>
                            <p style="margin: 5px 0 0 0;">
                                Période: <span t-field="o.date_from"/> au <span t-field="o.date_to"/>
                            </p>
                        </div>

                        <!-- Infos Entreprise et Employé -->
                        <table style="width: 100%; margin-bottom: 20px; border-collapse: collapse;">
                            <tr>
                                <td style="width: 50%; padding-right: 10px; vertical-align: top;">
                                    <div style="background-color: #f8f9fa; padding: 15px; border-radius: 8px;">
                                        <h3 style="margin: 0 0 10px 0; color: #2E86AB; font-size: 14px; font-weight: bold;">ENTREPRISE</h3>
                                        <p style="margin: 5px 0;"><strong><span t-field="o.company_id.name"/></strong></p>
                                        <p style="margin: 5px 0; font-size: 12px;">CNSS: <span t-field="o.company_id.company_cnss_id"/></p>
                                        <p style="margin: 5px 0; font-size: 12px;">CIMR: <span t-field="o.company_id.company_cimr_id"/></p>
                                        <p style="margin: 5px 0; font-size: 12px;">RC: <span t-field="o.company_id.rc"/></p>
                                        <p style="margin: 5px 0; font-size: 12px;">IF: <span t-field="o.company_id.ident_fiscal"/></p>
                                    </div>
                                </td>
                                <td style="width: 50%; padding-left: 10px; vertical-align: top;">
                                    <div style="background-color: #f8f9fa; padding: 15px; border-radius: 8px;">
                                        <h3 style="margin: 0 0 10px 0; color: #A23B72; font-size: 14px; font-weight: bold;">EMPLOYÉ</h3>
                                        <p style="margin: 5px 0;"><strong><span t-field="o.employee_id.name"/></strong></p>
                                        <p style="margin: 5px 0; font-size: 12px;">Matricule: <span t-field="o.employee_id.matricule"/></p>
                                        <p style="margin: 5px 0; font-size: 12px;">CIN: <span t-field="o.employee_id.identification_id"/></p>
                                        <p style="margin: 5px 0; font-size: 12px;">CNSS: <span t-field="o.employee_id.ssnid"/></p>
                                        <p style="margin: 5px 0; font-size: 12px;">Poste: <span t-field="o.contract_id.job_id"/></p>
                                        <p style="margin: 5px 0; font-size: 12px;">Date d'embauche: <span t-field="o.contract_id.date_start"/></p>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Tableau de paie -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px; border: 1px solid #ddd;">
                            <thead>
                                <tr style="background-color: #2E86AB; color: white;">
                                    <th style="padding: 10px; text-align: left; border: 1px solid #ddd;">Désignation</th>
                                    <th style="padding: 10px; text-align: center; border: 1px solid #ddd; width: 80px;">Nombre</th>
                                    <th style="padding: 10px; text-align: right; border: 1px solid #ddd; width: 100px;">Base</th>
                                    <th style="padding: 10px; text-align: right; border: 1px solid #ddd; width: 100px;">Gains</th>
                                    <th style="padding: 10px; text-align: right; border: 1px solid #ddd; width: 100px;">Retenus</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="line_count" t-value="0"/>
                                <t t-foreach="o.line_ids.filtered(lambda line: line.appears_on_payslip)" t-as="line">
                                    <t t-set="line_count" t-value="line_count + 1"/>
                                    <tr t-if="line.code != 'NET'" style="background-color: white if line_count % 2 == 0 else #f9f9f9;">
                                        <td style="padding: 8px; border: 1px solid #ddd; font-size: 12px;">
                                            <t t-if="line.code == 'GROSS'">
                                                <strong><span t-field="line.name"/></strong>
                                            </t>
                                            <t t-elif="line.code == 'IR'">
                                                <strong><span t-field="line.name"/></strong>
                                            </t>
                                            <t t-else="">
                                                <span t-field="line.name"/>
                                            </t>
                                        </td>
                                        <td style="padding: 8px; border: 1px solid #ddd; text-align: center; font-size: 12px;">
                                            <t t-if="line.code == 'JRTV' or line.code == 'JCP'">
                                                <span t-esc="'{:.0f}'.format(line.total or 0)"/>
                                            </t>
                                        </td>
                                        <td style="padding: 8px; border: 1px solid #ddd; text-align: right; font-size: 12px;">
                                            <t t-if="line.category_id.code not in ('PRINT', 'PRINNT', 'DED') and line.code not in ('NET', 'GROSS', 'IR', 'JRTV' , 'JCP')">
                                                <span t-esc="'{:.2f}'.format(line.amount or 0)"/>
                                            </t>
                                        </td>
                                        <td style="padding: 8px; border: 1px solid #ddd; text-align: right; font-size: 12px;">
                                            <t t-if="line.category_id.code != 'DED' and line.code not in ('IR', 'JRTV', 'JCP', 'NET')">
                                                <t t-if="line.category_id.code == 'GROSS'">
                                                    <span style="color: #27ae60; font-weight: bold;" t-esc="'{:.2f}'.format(line.total or 0)"/>
                                                </t>
                                                <t t-else="">
                                                    <span t-esc="'{:.2f}'.format(line.total or 0)"/>
                                                </t>
                                            </t>
                                        </td><td style="padding: 8px; border: 1px solid #ddd; text-align: right; font-size: 12px;">
                                            <t t-if="line.category_id.code == 'DED' or line.code == 'IR'">
                                                <span style="color: #e74c3c;" t-esc="'{:.2f}'.format(line.total or 0)"/>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Net à payer -->
                        <div style="text-align: right; margin-bottom: 30px;">
                            <t t-foreach="o.line_ids.filtered(lambda line: line.code == 'NET')" t-as="line">
                                <div style="background-color: #27ae60; color: white; padding: 15px 25px; border-radius: 8px; display: inline-block;">
                                    <p style="margin: 0 0 5px 0; font-size: 14px;">NET À PAYER</p>
                                    <p style="margin: 0; font-size: 28px; font-weight: bold;">
                                        <span t-esc="'{:.2f}'.format(line.total or 0)"/> DH
                                    </p>
                                </div>
                            </t>
                        </div>

                        <!-- Pied de page -->
                        <div style="border-top: 1px solid #ddd; padding-top: 15px; text-align: center; font-size: 11px; color: #666;">
                            <p>Ce bulletin de paie est conforme à la législation marocaine en vigueur.</p>
                            <p>Généré le <span t-esc="datetime.datetime.now().strftime('%d/%m/%Y à %H:%M')"/></p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>