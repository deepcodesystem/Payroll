<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_payslip" model="ir.actions.report">
        <field name="name">Bulletin de Paie</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_hr_ma_payroll.report_payslip</field>
        <field name="report_file">l10n_hr_ma_payroll.report_payslip</field>
        <field name="print_report_name">
'Bulletin de paie - %s' % (object.employee_id.name)
        </field>
        <field name="binding_model_id" ref="payroll.model_hr_payslip" />
        <field name="binding_type">report</field>
    </record>
    <record id="action_report_bank_advice" model="ir.actions.report">
        <field name="name">Bank Advice</field>
        <field name="model">hr.bank.advice</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_hr_ma_payroll.report_bank_advice</field>
        <field name="report_file">l10n_hr_ma_payroll.report_bank_advice</field>
        <field name="print_report_name">
'Bank Advice - %s' % (object.name)
        </field>
        <field name="binding_model_id" ref="model_hr_bank_advice" />
        <field name="binding_type">report</field>
    </record>
</odoo>