<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══ AFFILIÉ CNSS ═══════════════════════════════════════════════ -->
    <record id="view_cnss_affiliate_form" model="ir.ui.view">
        <field name="name">cnss.affiliate.form</field>
        <field name="model">cnss.affiliate</field>
        <field name="arch" type="xml">
            <form string="Affilié CNSS">
                <sheet>
                    <div class="oe_title">
                        <label for="num_affilie" string="Numéro Affilié CNSS"/>
                        <h1>
                            <field name="num_affilie" placeholder="1234567"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="company_id"/>
                            <field name="raison_sociale"/>
                            <field name="activite"/>
                            <field name="code_agence"/>
                        </group>
                        <group string="Coordonnées">
                            <field name="adresse"/>
                            <field name="ville"/>
                            <field name="code_postal"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cnss_affiliate_tree" model="ir.ui.view">
        <field name="name">cnss.affiliate.tree</field>
        <field name="model">cnss.affiliate</field>
        <field name="arch" type="xml">
            <list string="Affiliés CNSS">
                <field name="num_affilie"/>
                <field name="raison_sociale"/>
                <field name="activite"/>
                <field name="code_agence"/>
                <field name="ville"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_cnss_affiliate" model="ir.actions.act_window">
        <field name="name">Affiliés CNSS</field>
        <field name="res_model">cnss.affiliate</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configurer votre numéro d'affilié CNSS
            </p>
        </field>
    </record>

</odoo>
