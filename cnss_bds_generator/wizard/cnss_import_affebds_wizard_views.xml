<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Import AFFEBDS -->
    <record id="view_cnss_import_affebds_wizard_form" model="ir.ui.view">
        <field name="name">cnss.import.affebds.wizard.form</field>
        <field name="model">cnss.import.affebds.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Fichier Préétabli AFFEBDS">

                <!-- Étape 1 : Upload -->
                <div invisible="state != 'upload'">
                    <div class="alert alert-info" role="alert">
                        <p><strong>📄 Import du fichier préétabli Damancom</strong></p>
                        <p>Ce wizard permet d'importer automatiquement les données du fichier
                           préétabli AFFEBDS téléchargé depuis le portail
                           <a href="https://www.damancom.ma" target="_blank">Damancom</a>.</p>
                        <p>Le fichier contient la liste des assurés déclarés le mois précédent
                           avec leurs informations AF (Allocations Familiales).</p>
                    </div>

                    <group>
                        <group string="Fichier à importer">
                            <field name="declaration_id" readonly="1"/>
                            <field name="affebds_file" filename="affebds_filename"
                                   widget="binary" required="1"/>
                            <field name="affebds_filename" invisible="1"/>
                        </group>
                        <group string="Options">
                            <field name="replace_existing"/>
                            <field name="update_affiliate"/>
                        </group>
                    </group>

                    <footer>
                        <button name="action_parse_file" string="📥 Analyser le fichier"
                                type="object" class="btn-primary"/>
                        <button string="Annuler" special="cancel" class="btn-secondary"/>
                    </footer>
                </div>

                <!-- Étape 2 : Aperçu -->
                <div invisible="state != 'preview'">
                    <div class="alert alert-success" role="alert">
                        <strong>✅ Fichier analysé avec succès</strong>
                    </div>

                    <group>
                        <group string="Informations Affilié (depuis fichier)">
                            <field name="parsed_num_affilie"/>
                            <field name="parsed_raison_sociale"/>
                            <field name="parsed_adresse"/>
                            <field name="parsed_ville"/>
                            <field name="parsed_code_postal"/>
                            <field name="parsed_code_agence"/>
                        </group>
                        <group string="Période &amp; Dates">
                            <field name="parsed_periode"/>
                            <field name="parsed_identif_transfert"/>
                            <field name="parsed_date_emission"/>
                            <field name="parsed_date_exigibilite"/>
                            <field name="parsed_total_assures"/>
                        </group>
                    </group>

                    <separator string="Assurés à importer"/>
                    <field name="preview_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="a_importer"/>
                            <field name="num_assure"/>
                            <field name="nom"/>
                            <field name="prenom"/>
                            <field name="nom_prenom" optional="hide"/>
                            <field name="enfants" optional="show"/>
                            <field name="af_a_payer" optional="hide"/>
                            <field name="af_a_deduire" optional="hide"/>
                        </list>
                    </field>

                    <footer>
                        <button name="action_import" string="✅ Importer dans la déclaration"
                                type="object" class="btn-primary"/>
                        <button name="action_back_upload" string="⬅ Retour"
                                type="object" class="btn-secondary"/>
                        <button string="Annuler" special="cancel" class="btn-secondary"/>
                    </footer>
                </div>

                <field name="state" invisible="1"/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cnss_import_affebds_wizard" model="ir.actions.act_window">
        <field name="name">Import Fichier Préétabli AFFEBDS</field>
        <field name="res_model">cnss.import.affebds.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>

