<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Document Type List View -->
        <record id="view_document_type_tree" model="ir.ui.view">
            <field name="name">document.type.list</field>
            <field name="model">document.type</field>
            <field name="arch" type="xml">
                <list string="Document Types">
                    <field name="sequence" widget="handle"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="require_manager_approval"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        <!-- Document Type Form View -->
        <record id="view_document_type_form" model="ir.ui.view">
            <field name="name">document.type.form</field>
            <field name="model">document.type</field>
            <field name="arch" type="xml">
                <form string="Document Type">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                                <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Document Type Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code" placeholder="e.g., WORK_CERT"/>
                                <field name="sequence"/>
                                <field name="color" widget="color"/>
                            </group>
                            <group>
                                <field name="require_manager_approval" widget="boolean_button"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" nolabel="1" placeholder="Description of this document type..."/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        <!-- Document Type Search View -->
        <record id="view_document_type_search" model="ir.ui.view">
            <field name="name">document.type.search</field>
            <field name="model">document.type</field>
            <field name="arch" type="xml">
                <search string="Search Document Types">
                    <field name="name"/>
                    <field name="code"/>
                    <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                    <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                    <filter name="requires_approval" string="Requires Approval" domain="[('require_manager_approval', '=', True)]"/>
                </search>
            </field>
        </record>
        <!-- Document Type Action -->
        <record id="action_document_type" model="ir.actions.act_window">
            <field name="name">Document Types</field>
            <field name="res_model">document.type</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_document_type_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new document type
                </p>
                <p>
                    Organize your employee documents by type (e.g., Work Certificates, Training Certificates, etc.)
                </p>
            </field>
        </record>
    </data>
</odoo>
