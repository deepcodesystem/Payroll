<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Add Documents page to HR Employee form -->
        <record id="view_employee_document_page" model="ir.ui.view">
            <field name="name">hr.employee.document</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='personal_information']" position="after">
                    <page name="documents" string="Documents">
                        <field name="document_ids">
                            <list string="Employee Documents" create="true" delete="true">
                                <field name="document_type_id"/>
                                <field name="name"/>
                                <field name="issue_date"/>
                                <field name="expiry_date"/>
                                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'pending'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
