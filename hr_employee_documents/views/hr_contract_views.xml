<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add salary_net field after wage in Salary Information -->
    <record id="view_hr_contract_salary_net" model="ir.ui.view">
        <field name="name">hr.contract.salary.net</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='wage']" position="after">
                <label for="salary_net"/>
                <div class="o_row mw-50" name="salary_net">
                    <field name="salary_net" class="oe_inline o_hr_narrow_field" nolabel="1"/>
                    <div class="mb-3" name="wage_period_label">/ mois</div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
