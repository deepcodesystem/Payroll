<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Add report generation button to HR Employee form -->
        <record id="view_employee_report_buttons" model="ir.ui.view">
            <field name="name">hr.employee.report.buttons</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_generate_employee_report" string="📄 Download Reports" type="object" class="oe_stat_button" icon="fa-file-download"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
