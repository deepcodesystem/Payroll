<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Employee can only see their own documents that are visible -->
        <record id="employee_document_rule_employee_own" model="ir.rule">
            <field name="name">Employee can see own documents</field>
            <field name="model_id" ref="model_employee_document"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id), ('is_visible_to_employee', '=', True)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Managers can see all documents for their subordinates -->
        <record id="employee_document_rule_manager" model="ir.rule">
            <field name="name">Manager can see subordinate documents</field>
            <field name="model_id" ref="model_employee_document"/>
            <field name="domain_force">[('employee_id.parent_id.user_id', '=', user.id)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
        </record>

        <!-- HR managers can see all documents -->
        <record id="employee_document_rule_hr_manager" model="ir.rule">
            <field name="name">HR manager can see all documents</field>
            <field name="model_id" ref="model_employee_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
        </record>

        <!-- Report template access by group_ids: si group_ids est vide → tout le monde,
             sinon seuls les utilisateurs dans au moins un des groupes peuvent voir le modèle -->
        <record id="report_template_group_rule" model="ir.rule">
            <field name="name">Report template: user must be in required groups</field>
            <field name="model_id" ref="model_hr_employee_report_template"/>
            <field name="domain_force">['|', ('group_ids', '=', False), ('group_ids', 'in', user.groups_id.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

    </data>
</odoo>
