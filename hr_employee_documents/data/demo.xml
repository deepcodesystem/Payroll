<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Sample Document Types (already in document_type_data.xml, but here for demo reference) -->

        <!-- Sample Employees and Documents -->
        <record id="employee_sample_1" model="hr.employee">
            <field name="name">Marie Dupont</field>
            <field name="department_id" ref="hr.department_sales"/>
        </record>

        <record id="employee_sample_2" model="hr.employee">
            <field name="name">Pierre Martin</field>
            <field name="department_id" ref="hr.department_it"/>
            <field name="parent_id" ref="employee_sample_1"/>
        </record>

        <!-- Sample Employee Documents -->
        <record id="employee_document_sample_1" model="employee.document">
            <field name="employee_id" ref="employee_sample_2"/>
            <field name="document_type_id" ref="document_type_work_certificate"/>
            <field name="name">Work Certificate - Pierre Martin</field>
            <field name="description">Official work certificate for employment verification</field>
            <field name="document_file"></field>
            <field name="issue_date">2024-01-15</field>
            <field name="expiry_date">2026-01-15</field>
            <field name="state">approved</field>
        </record>

    </data>
</odoo>
