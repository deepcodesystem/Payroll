<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Simple template for employee document rendering -->
        <template id="report_employee_document_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <div class="page">
                        <t t-out="doc_content" />
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>
